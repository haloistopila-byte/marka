# Port server (default 3000)
PORT=

# Alamat yang didengar server (default 0.0.0.0). Isi 127.0.0.1 supaya hanya bisa dibuka dari komputer ini.
HOST=

# Domain yang boleh memanggil /api dari browser, pisahkan dengan koma. Same-origin selalu boleh.
ALLOWED_ORIGINS=

# Prompt username/password browser di depan seluruh app. Aktif hanya kalau salah satu password diisi.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Atau hash scrypt, bukan password polos: scrypt$<salt hex>$<hash hex>
BASIC_AUTH_PASSWORD_HASH=
BASIC_AUTH_MAX_FAILURES=
BASIC_AUTH_LOCKOUT_MINUTES=

# Google Calendar. Tanpa ini app tetap jalan, hanya sinkron yang mati. Isi di file .env di folder project, atau di %APPDATA%\Marka Photobooth\.env untuk app yang dipasang lewat PowerShell.
# Lokasi file kunci service account project marka-96250 (Firebase Console > Project settings > Service accounts).
FIREBASE_SERVICE_ACCOUNT_FILE=
# Atau isi file kunci itu sendiri dalam satu baris
FIREBASE_SERVICE_ACCOUNT=
# OAuth Client tipe "Web application" di Google Cloud project marka-96250.
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opsional. Default: alamat app ini + /auth/google/callback
GOOGLE_REDIRECT_URI=
